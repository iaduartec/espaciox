APP_NAME=EspacioX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<tu-dominio-o-el-temporal-de-railway>

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=<tu-host-mysql-de-railway>
DB_PORT=3306
DB_DATABASE=<tu-db>
DB_USERNAME=<tu-usuario>
DB_PASSWORD=<tu-password>

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=<dominio-del-front>
# Habilita el seed de datos demo en Railway si lo necesitas
SEED_DEMO=false
